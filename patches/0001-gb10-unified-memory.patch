+# --- comfyui-patch: GB10 unified memory ----------------------------------------
+# docs/phase-1.md §5.1, §8.2. On Grace-Blackwell the CPU and the GPU share one
+# physical memory pool. Several policies below were written for a discrete
+# card, where VRAM and system RAM are separate budgets and moving a tensor
+# between them genuinely frees device pages. Here both premises are false:
+#   - the budget is not total_vram + total_ram (~243 GB on a 121 GB box);
+#   - "offload to CPU" frees no physical page, it only changes allocator.
+# Left uncorrected, ComfyUI never evicts anything and the render peak is the
+# sum of every stage rather than the largest one.
+#
+# Detected rather than configured, because a wrong answer here is silent:
+# everything still runs, just with a memory plan built on a false premise.
+# `is_integrated` is the direct signal (1 on GB10); the ratio test is the
+# fallback, and no discrete card can coincide with host RAM to within 10%.
+def _gb10_unified_memory():
+    override = os.environ.get("COMFY_GB10_UNIFIED_MEMORY", "auto").strip().lower()
+    if override in ("0", "false", "off", "no"):
+        return False
+    if override in ("1", "true", "on", "yes"):
+        return True
+    if cpu_state != CPUState.GPU or directml_enabled:
+        return False
+    try:
+        props = torch.cuda.get_device_properties(get_torch_device())
+    except Exception:
+        return False
+    if getattr(props, "is_integrated", 0):
+        return True
+    # Deliberately psutil's host total and not system_memory's cgroup-aware
+    # one: under a §5.3 memory cap the capped figure would not match the
+    # device total, and unified memory would go undetected exactly where it
+    # matters most.
+    host_total = psutil.virtual_memory().total
+    if host_total <= 0:
+        return False
+    return 0.90 <= (props.total_memory / host_total) <= 1.10
+
+
+UNIFIED_MEMORY = _gb10_unified_memory()
+
